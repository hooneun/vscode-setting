{
  "vim.useCtrlKeys": true, // Vim 모드에서 Ctrl 키 매핑 활성화 여부
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
    "<C-z>": false
    // "<Tab>": true, // Tab 키를 Vim이 처리하지 못하도록 설정
    // "<S-Tab>": ture // Shift+Tab도 Vim이 처리하지 않도록 설정
  },
  "editor.cursorBlinking": "expand", // 커서가 깜박일 때 확장되는 애니메이션 효과를 적용합니다
  "workbench.activityBar.location": "hidden", // 좌측의 활동 바(파일 탐색기, 검색 등의 아이콘 모음)를 숨깁니다
  "workbench.statusBar.visible": false, // 하단의 상태 표시줄을 숨깁니다
  "editor.minimap.enabled": false, // 레이아웃 제어 버튼(창 분할 등)을 비활성화합니다
  "breadcrumbs.enabled": false, // 파일 경로와 코드 구조를 보여주는 상단의 이동 경로(브레드크럼)를 비활성화합니다
  "workbench.tips.enabled": false, // VS Code 사용 팁 표시를 비활성화합니다
  "workbench.startupEditor": "none", // VS Code 시작 시 시작 페이지를 표시하지 않습니다
  "editor.overviewRulerBorder": false, // 스크롤바 옆 오버뷰 룰러의 테두리를 제거합니다
  "editor.hideCursorInOverviewRuler": true, // 오버뷰 룰러에서 커서 위치 표시를 숨깁니다
  "editor.matchBrackets": "never", // 괄호 쌍 강조 표시 기능을 비활성화합니다
  "editor.hover.delay": 1500, // 마우스 호버 시 정보가 표시되기까지의 지연 시간을 1.5초로 설정합니다
  "editor.hover.enabled": true, // 마우스 호버 시 정보 표시 기능을 활성화합니다
  "editor.gotoLocation.multipleReferences": "goto", // 여러 참조가 있을 때 바로 첫 번째 참조로 이동합니다
  "editor.gotoLocation.multipleDefinitions": "goto", // 여러 정의가 있을 때 바로 첫 번째 정의로 이동합니다
  "editor.gotoLocation.multipleDeclarations": "goto", // 여러 선언이 있을 때 바로 첫 번째 선언으로 이동합니다
  "workbench.editor.enablePreviewFromQuickOpen": false, // 빠른 열기에서 파일을 선택할 때 미리보기 모드가 아닌 정식 편집기로 엽니다
  "editor.gotoLocation.multipleImplementations": "goto", // 여러 구현이 있을 때 바로 첫 번째 구현으로 이동합니다
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false, // 여러 타입 정의가 있을 때 바로 첫 번째 타입 정의로 이동합니다
  "window.density.editorTabHeight": "compact",
  "workbench.editor.wrapTabs": true,
  "workbench.editor.tabSizing": "shrink"
}
